#!/usr/bin/env bash
# AstraOS build helper.
#
# Single dispatcher for rebuilding the devcontainer, building image variants,
# building the cross-SDK, and bitbake-ing any single recipe.
#
# Defaults to remote execution against the AstraOS build machine
# (10.11.12.20 / Tailscale 100.82.113.92, ssh user akothapalli, passwordless
# key auth). Use --local to run against your local Docker daemon instead.
#
# Layered detection:
#   * --local on a Mac/dev box      docker run on local Docker
#   * default (no --local)          ssh akothapalli@10.11.12.20 then
#                                   docker run there
#   * already inside devcontainer   skip docker, just bash -c
#
# Usage:
#   scripts/build [--local | --remote] container
#   scripts/build [--local | --remote] image       <MACHINE>
#   scripts/build [--local | --remote] prod-image
#   scripts/build [--local | --remote] sdk         <MACHINE>
#   scripts/build [--local | --remote] recipe      <MACHINE> <RECIPE> [TASK]
#   scripts/build [--local | --remote] bitbake     <MACHINE> <args...>
#   scripts/build [--local | --remote] shell       <MACHINE>
#
# MACHINE: raspberrypi5 | raspberrypi-cm5 | imx8mp-var-som | astraos-imx8mp-mcb
#
# Override remote target with env vars (defaults shown):
#   ASTRAOS_BUILDER_HOST=10.11.12.20
#   ASTRAOS_BUILDER_USER=akothapalli
#   ASTRAOS_BUILDER_PORT=22
#   ASTRAOS_BUILDER_PATH=~/AstraOS

set -euo pipefail

ASTRAOS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE_TAG="astraos-builder:latest"

BUILDER_HOST="${ASTRAOS_BUILDER_HOST:-10.11.12.20}"
BUILDER_USER="${ASTRAOS_BUILDER_USER:-akothapalli}"
BUILDER_PORT="${ASTRAOS_BUILDER_PORT:-22}"
BUILDER_PATH="${ASTRAOS_BUILDER_PATH:-/yocto/astraos}"

MODE=""    # auto by default; set by --local / --remote

usage() {
    cat <<EOF
AstraOS build helper.

Usage (all subcommands accept an optional --local | --remote prefix):
  scripts/build container                              Rebuild the devcontainer image
  scripts/build image       <MACHINE>                  Build astraos-image-dev for MACHINE
  scripts/build prod-image                             Build astraos-image (mcb production)
  scripts/build sdk         <MACHINE>                  Build astraos-sdk for MACHINE
  scripts/build recipe      <MACHINE> <RECIPE> [TASK]  bitbake [-c TASK] RECIPE
  scripts/build bitbake     <MACHINE> <args...>        bitbake passthrough
  scripts/build shell       <MACHINE>                  Interactive shell, env sourced

MACHINE: raspberrypi5 | raspberrypi-cm5 | imx8mp-var-som | astraos-imx8mp-mcb

Default mode: --remote, dispatches via ssh to the build machine
  ${BUILDER_USER}@${BUILDER_HOST}:${BUILDER_PORT} (path: ${BUILDER_PATH})
Pass --local to run on the local Docker daemon instead.
EOF
    exit 1
}

_in_container() {
    [ -f /.dockerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ]
}

_ensure_image() {
    if ! docker image inspect "${IMAGE_TAG}" >/dev/null 2>&1; then
        echo ">>> Container image not found; building it first..."
        _build_container
    fi
}

_build_container() {
    docker build \
        --build-arg USER_UID="$(id -u 2>/dev/null || echo 1000)" \
        --build-arg USER_GID="$(id -g 2>/dev/null || echo 1000)" \
        -t "${IMAGE_TAG}" \
        "${ASTRAOS_ROOT}/.devcontainer"
}

# Run a bash command inside the build env. On the host this docker-runs;
# inside the container it just bash -c's.
_run() {
    local cmd="$1"
    if _in_container; then
        bash -c "${cmd}"
    else
        _ensure_image
        # Bind /yocto/sstate and /yocto/downloads from host when they exist
        # (build machine layout); otherwise use named docker volumes mounted
        # at the same in-container path. local.conf.in references
        # /yocto/sstate and /yocto/downloads regardless.
        local sstate_mount dl_mount
        if [ -d /yocto/sstate ]; then
            sstate_mount="-v /yocto/sstate:/yocto/sstate"
        else
            sstate_mount="-v astraos-sstate:/yocto/sstate"
        fi
        if [ -d /yocto/downloads ]; then
            dl_mount="-v /yocto/downloads:/yocto/downloads"
        else
            dl_mount="-v astraos-downloads:/yocto/downloads"
        fi
        # Bind /yocto/astraos as the workspace when running on the builder;
        # otherwise bind the local checkout dir.
        local workspace_src
        if [ -d /yocto/astraos ] && [ "${ASTRAOS_ROOT}" = "/yocto/astraos" ]; then
            workspace_src=/yocto/astraos
        else
            workspace_src="${ASTRAOS_ROOT}"
        fi
        docker run --rm -it \
            -v "${workspace_src}:/yocto/astraos" \
            ${sstate_mount} \
            ${dl_mount} \
            --shm-size=2g \
            --security-opt apparmor=unconfined \
            --security-opt seccomp=unconfined \
            -w /yocto/astraos \
            "${IMAGE_TAG}" \
            bash -lc "${cmd}"
    fi
}

# Validate MACHINE is one of the four known targets
_check_machine() {
    case "$1" in
        raspberrypi5|raspberrypi-cm5|imx8mp-var-som|astraos-imx8mp-mcb) ;;
        *)
            echo "ERROR: unknown MACHINE '$1'" >&2
            echo "Valid: raspberrypi5, raspberrypi-cm5, imx8mp-var-som, astraos-imx8mp-mcb" >&2
            exit 1
            ;;
    esac
}

# Short-circuit help / empty BEFORE any mode dispatch
case "${1:-}" in
    ""|-h|--help|help) usage ;;
esac

# Parse leading mode flag if present
case "${1:-}" in
    --local)  MODE=local;  shift ;;
    --remote) MODE=remote; shift ;;
esac

# Re-check after mode flag consumption
case "${1:-}" in
    ""|-h|--help|help) usage ;;
esac

# Auto-pick mode if user didn't specify
if [ -z "${MODE}" ]; then
    if _in_container; then
        MODE=local         # already inside the build env; just bash -c
    else
        MODE=remote        # default: dispatch to the build machine
    fi
fi

# Remote dispatch: SSH to builder and re-invoke ourselves with --local.
# Args are passed as a single quoted string; spaces in args are preserved
# by `printf '%q '` quoting before sending.
if [ "${MODE}" = "remote" ]; then
    quoted_args=$(printf '%q ' "$@")
    echo ">>> Dispatching to ${BUILDER_USER}@${BUILDER_HOST}:${BUILDER_PATH}"
    exec ssh -t -p "${BUILDER_PORT}" "${BUILDER_USER}@${BUILDER_HOST}" \
        "cd ${BUILDER_PATH} && ./scripts/build --local ${quoted_args}"
fi

cmd="${1:-}"
shift || true

case "${cmd}" in
    container)
        _build_container
        ;;

    image)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake astraos-image-dev"
        ;;

    prod-image)
        _run "source scripts/setup-environment astraos-imx8mp-mcb && bitbake astraos-image"
        ;;

    sdk)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake astraos-sdk"
        ;;

    recipe)
        MACHINE="${1:-}"; RECIPE="${2:-}"; TASK="${3:-}"
        { [ -z "$MACHINE" ] || [ -z "$RECIPE" ]; } && usage
        _check_machine "$MACHINE"
        if [ -n "$TASK" ]; then
            _run "source scripts/setup-environment ${MACHINE} && bitbake -c ${TASK} ${RECIPE}"
        else
            _run "source scripts/setup-environment ${MACHINE} && bitbake ${RECIPE}"
        fi
        ;;

    bitbake)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        shift
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && bitbake $*"
        ;;

    shell)
        MACHINE="${1:-}"; [ -z "$MACHINE" ] && usage
        _check_machine "$MACHINE"
        _run "source scripts/setup-environment ${MACHINE} && exec bash"
        ;;

    ""|-h|--help|help)
        usage
        ;;

    *)
        echo "ERROR: unknown subcommand '${cmd}'" >&2
        usage
        ;;
esac
